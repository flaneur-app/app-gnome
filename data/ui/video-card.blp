using Gtk 4.0;

// One item of the video grid: a fixed 16:9 thumbnail (images are cropped to cover it), the
// service it comes from, the title, the channel (a button to its page) and the views and date.
// Until the thumbnail loads, the frame shows the kind of item.
template $FlaneurVideoCard: Gtk.Box {
  orientation: vertical;
  spacing: 4;
  width-request: 240;
  halign: center;

  Gtk.Overlay {
    child: Gtk.Picture thumbnail {
      width-request: 240;
      height-request: 135;
      content-fit: cover;
      overflow: hidden;

      styles [
        "thumbnail",
      ]
    };

    [overlay]
    Gtk.Image placeholder {
      icon-name: "video-x-generic-symbolic";
      pixel-size: 32;
      halign: center;
      valign: center;

      styles [
        "dim-label",
      ]
    }

    [overlay]
    Gtk.Label service {
      halign: start;
      valign: start;

      styles [
        "service-badge",
      ]
    }

    [overlay]
    Gtk.Label badge {
      halign: end;
      valign: end;
      visible: false;

      styles [
        "duration-badge",
      ]
    }

    [overlay]
    Gtk.ProgressBar progress {
      valign: end;
      visible: false;

      styles [
        "watch-progress",
      ]
    }
  }

  Gtk.Label title {
    xalign: 0;
    wrap: true;
    wrap-mode: word_char;
    lines: 2;
    ellipsize: end;
    max-width-chars: 24;
    margin-top: 2;

    styles [
      "heading",
    ]
  }

  // Its action, win.show-channel, is set with its target when an item is bound.
  Gtk.Button channel {
    halign: start;

    child: Gtk.Label channel_label {
      xalign: 0;
      ellipsize: end;
      max-width-chars: 24;
    };

    styles [
      "flat",
      "channel-button",
      "caption",
    ]
  }

  Gtk.Label meta {
    xalign: 0;
    ellipsize: end;
    max-width-chars: 24;

    styles [
      "dim-label",
      "caption",
    ]
  }
}
