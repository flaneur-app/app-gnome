using Gtk 4.0;
using Adw 1;

template $FlaneurWindow: Adw.ApplicationWindow {
  title: "Flâneur";
  default-width: 1100;
  default-height: 720;
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      split_view.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationView navigation {
      Adw.NavigationPage {
        title: "Flâneur";
        tag: "browse";

        child: Adw.NavigationSplitView split_view {
          min-sidebar-width: 200;

          sidebar: Adw.NavigationPage {
            title: "Flâneur";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [end]
                Gtk.MenuButton {
                  primary: true;
                  icon-name: "open-menu-symbolic";
                  tooltip-text: _("Main Menu");
                  menu-model: primary_menu;
                }
              }

              content: Gtk.ScrolledWindow {
                hscrollbar-policy: never;

                child: Gtk.ListBox sidebar {
                  styles [
                    "navigation-sidebar",
                  ]

                  Gtk.ListBoxRow {
                    name: "home";

                    child: Gtk.Box {
                      spacing: 12;

                      Gtk.Image {
                        icon-name: "user-home-symbolic";
                      }

                      Gtk.Label {
                        label: _("Home");
                        xalign: 0;
                      }
                    };
                  }

                  Gtk.ListBoxRow {
                    name: "subscriptions";

                    child: Gtk.Box {
                      spacing: 12;

                      Gtk.Image {
                        icon-name: "starred-symbolic";
                      }

                      Gtk.Label {
                        label: _("Subscriptions");
                        xalign: 0;
                      }
                    };
                  }

                  Gtk.ListBoxRow {
                    name: "history";

                    child: Gtk.Box {
                      spacing: 12;

                      Gtk.Image {
                        icon-name: "document-open-recent-symbolic";
                      }

                      Gtk.Label {
                        label: _("History");
                        xalign: 0;
                      }
                    };
                  }

                  Gtk.ListBoxRow {
                    name: "search";

                    child: Gtk.Box {
                      spacing: 12;

                      Gtk.Image {
                        icon-name: "system-search-symbolic";
                      }

                      Gtk.Label {
                        label: _("Search");
                        xalign: 0;
                      }
                    };
                  }

                  Gtk.ListBoxRow {
                    name: "accounts";

                    child: Gtk.Box {
                      spacing: 12;

                      Gtk.Image {
                        icon-name: "system-users-symbolic";
                      }

                      Gtk.Label {
                        label: _("Accounts");
                        xalign: 0;
                      }
                    };
                  }
                };
              };
            };
          };

          content: Adw.NavigationPage content_page {
            title: _("Home");

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [end]
                Gtk.Button add_feed_button {
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("Add Feed");
                  action-name: "win.add-feed";
                  visible: false;
                }
              }

              content: Gtk.Stack stack {
                transition-type: crossfade;

                Gtk.StackPage {
                  name: "home";
                  title: _("Home");

                  child: $FlaneurFeedPage home_page {};
                }

                Gtk.StackPage {
                  name: "subscriptions";
                  title: _("Subscriptions");

                  child: $FlaneurFeedPage subscriptions_page {};
                }

                Gtk.StackPage {
                  name: "history";
                  title: _("History");

                  child: $FlaneurFeedPage history_page {};
                }

                Gtk.StackPage {
                  name: "search";
                  title: _("Search");

                  child: $FlaneurSearchPage search_page {};
                }

                Gtk.StackPage {
                  name: "accounts";
                  title: _("Accounts");

                  child: $FlaneurAccountsPage accounts_page {};
                }
              };
            };
          };
        };
      }

      $FlaneurPlayerPage player_page {}
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Accounts");
      action: "win.show-accounts";
    }

    item {
      label: _("_About Flâneur");
      action: "app.about";
    }
  }
}
